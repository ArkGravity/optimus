/bin/
/tmp/
/server
*.test
*.out
/coverage/
/postgres-data/

# Web (Bun / Vite / test output). web/dist is embedded by go:embed; the
# placeholder keeps backend-only builds compiling without a frontend build.
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/coverage/
*.tsbuildinfo
